/*
 * Device Tree Overlay for PiSugar 2.8" ST7701P MIPI-DSI display
 *
 * Panel:  ST7701P 480x640, 2-lane MIPI-DSI on selected DSI port
 * Touch:  GT911 @ 0x5d on matching i2c_csi_dsi bus
 *
 * GPIO allocation:
 *   GPIO4   - Panel reset   (active-low)
 *   GPIO22  - Backlight      (active-low)
 *   GPIO6   - Touch reset   (active-low)
 *   GPIO13  - Touch IRQ     (active-low, falling-edge interrupt)
 *
 * Touch uses the in-tree Goodix driver. The driver temporarily drives the INT
 * line low during reset to select the GT911 I2C address 0x5d, then switches it
 * back to an active-low interrupt input.
 */

#ifndef DSI_PORT
#define DSI_PORT 0
#endif

#if DSI_PORT == 1
#define DSI_NODE dsi1
#define DSI_I2C_NODE i2c_csi_dsi1
#define DSI_OUT_ENDPOINT dsi1_out_panel
#else
#define DSI_NODE dsi0
#define DSI_I2C_NODE i2c_csi_dsi0
#define DSI_OUT_ENDPOINT dsi0_out_panel
#endif

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	/* Fragment 0: MIPI-DSI panel on selected port */
	fragment@0 {
		target = <&DSI_NODE>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			panel@0 {
				compatible = "pisugar,st7701p-480x640";
				reg = <0>;
				reset-gpios = <&gpio 4 1>;  /* GPIO4, active-low */
				ledc-gpios = <&gpio 22 1>;  /* GPIO22, active-low */
				status = "okay";

				port {
					panel_in: endpoint {
						remote-endpoint = <&DSI_OUT_ENDPOINT>;
					};
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					DSI_OUT_ENDPOINT: endpoint {
						remote-endpoint = <&panel_in>;
						data-lanes = <0 1>;
					};
				};
			};
		};
	};

	/* Fragment 1: GT911 GPIO pin configuration */
	fragment@1 {
		target = <&gpio>;
		__overlay__ {
			gt911_pins: gt911_pins {
				brcm,pins = <6 13>;
				brcm,function = <0 0>; /* inputs */
				brcm,pull = <2 2>;     /* pull-up */
			};
		};
	};

	/* Fragment 2: GT911 touch on DSI connector I2C bus */
	fragment@2 {
		target = <&DSI_I2C_NODE>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			touch@5d {
				compatible = "goodix,gt911";
				reg = <0x5d>;
				pinctrl-names = "default";
				pinctrl-0 = <&gt911_pins>;
				interrupt-parent = <&gpio>;
				interrupts = <13 2>;       /* falling edge */
				irq-gpios = <&gpio 13 0>;  /* GPIO13, active-high GPIO semantics */
				reset-gpios = <&gpio 6 0>; /* GPIO6, active-high GPIO semantics */
				touchscreen-size-x = <480>;
				touchscreen-size-y = <640>;
				touchscreen-inverted-x;
				touchscreen-inverted-y;
				status = "okay";
			};
		};
	};
};
