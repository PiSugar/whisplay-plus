/*
 * Device Tree Overlay for PiSugar 2.8" ST7701P MIPI-DSI display
 *
 * Panel:  ST7701P 480x640, 2-lane MIPI-DSI on selected DSI port
 * Touch:  FT6336U @ 0x38 on matching i2c_csi_dsi bus, polling mode (no IRQ)
 *
 * GPIO allocation:
 *   GPIO4   - Panel reset   (active-low)
 *   GPIO22  - Backlight      (active-low)
 *   GPIO6   - Touch reset   (active-low)
 *   GPIO13  - Touch IRQ     (active-low, physically not connected on this HW)
 *
 * Touch uses edt_ft5x06 kernel driver in timer-based polling mode
 * (17ms interval) since the INT line is not wired through DSI connector.
 */

#ifndef DSI_PORT
#define DSI_PORT 0
#endif

#if DSI_PORT == 1
#define DSI_NODE dsi1
#define DSI_I2C_NODE i2c_csi_dsi1
#define DSI_OUT_ENDPOINT dsi1_out_panel
#else
#define DSI_NODE dsi0
#define DSI_I2C_NODE i2c_csi_dsi0
#define DSI_OUT_ENDPOINT dsi0_out_panel
#endif

/dts-v1/;
/plugin/;

/ {
	compatible = "brcm,bcm2712";

	/* Fragment 0: MIPI-DSI panel on selected port */
	fragment@0 {
		target = <&DSI_NODE>;
		__overlay__ {
			status = "okay";
			#address-cells = <1>;
			#size-cells = <0>;

			panel@0 {
				compatible = "pisugar,st7701p-480x640";
				reg = <0>;
				reset-gpios = <&gpio 4 1>;  /* GPIO4, active-low */
				ledc-gpios = <&gpio 22 1>;  /* GPIO22, active-low */
				status = "okay";

				port {
					panel_in: endpoint {
						remote-endpoint = <&DSI_OUT_ENDPOINT>;
					};
				};
			};

			ports {
				port@0 {
					reg = <0>;
					DSI_OUT_ENDPOINT: endpoint {
						remote-endpoint = <&panel_in>;
						data-lanes = <0 1>;
					};
				};
			};
		};
	};

	/* Fragment 1: FT6336U touch on DSI connector I2C bus */
	fragment@1 {
		target = <&DSI_I2C_NODE>;
		__overlay__ {
			status = "okay";

			touch@38 {
				compatible = "focaltech,ft6236";
				reg = <0x38>;
				reset-gpios = <&gpio 6 1>;  /* GPIO6, active-low */
				touchscreen-size-x = <480>;
				touchscreen-size-y = <640>;
				status = "okay";
				/* No interrupts - edt_ft5x06 falls back to polling */
			};
		};
	};
};
